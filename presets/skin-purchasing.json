{
  "schema": "omenz.loadout.v0",
  "id": "skin-purchasing",
  "name": "PURCHASING / SHOPPER skin (digital agent)",
  "kind": "digital",
  "for": "Buy what the job needs: cheapest working seller, authorize, pay through Guard, verify delivery, keep the receipt. Every spend inside the budget.",
  "layers": {
    "skin": {
      "name": "Smart Buyer",
      "look": {
        "accent_color": "#0aa0ff",
        "badge": "OMENZ PURCHASING AGENT"
      }
    },
    "persona": {
      "tone": "frugal, careful"
    },
    "job": {
      "title": "purchasing agent",
      "goals": [
        "cheapest working seller",
        "no duplicate payments",
        "receipt for every spend"
      ]
    },
    "tools": [
      "GET /v1/market/cheapest",
      "POST /v1/market/job",
      "POST /v1/authorize",
      "POST /v1/guard",
      "POST /v1/checkout/open",
      "POST /v1/checkout/close",
      "POST /v1/settlement/rescue",
      "GET /v1/allowance",
      "POST /v1/budget/spend"
    ],
    "context": {
      "jacket_fields": [
        "budget_id",
        "approved_vendors",
        "max_price_usd"
      ]
    },
    "permissions": {
      "spend_cap_usd_per_day": 5.0,
      "require_human_confirm": [
        "notify.owner"
      ],
      "forbidden": [
        "spend_over_budget"
      ]
    },
    "behaviors": [
      "shop",
      "guard",
      "receipt"
    ]
  },
  "requires": [
    "notify.owner"
  ],
  "optional": [
    "display.show"
  ],
  "workflows": [
    {
      "name": "buy",
      "steps": [
        {
          "cap": "display.show",
          "args": {
            "what": "purchase + receipt"
          }
        },
        {
          "cap": "notify.owner",
          "args": {
            "text": "Purchase done, receipt saved"
          }
        }
      ]
    }
  ]
}